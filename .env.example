# Copy this file to `.env` and fill in values. Never commit `.env`.
# All variables are optional; the defaults noted below are used when unset.
# Restart the dev server after changing any of them.

# Off-chain pools index API.
# Default: https://uniswap-clone-bt9l.onrender.com
VITE_POOLS_API_BASE=

# Polygon Amoy RPC (swaps / pools). Use your own node if the public one is slow or blocked.
# Default: https://rpc-amoy.polygon.technology
# e.g. https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
VITE_POLYGON_AMOY_RPC=

# Polygon Amoy RPC for historical log queries (positions). Falls back to VITE_POLYGON_AMOY_RPC.
# Pick a node that allows wide eth_getLogs ranges.
VITE_POLYGON_AMOY_HISTORY_RPC=

# Base Sepolia RPC (lending). Placed first; public endpoints remain as fallbacks.
# e.g. https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
VITE_BASE_SEPOLIA_RPC=

# Transaction / token-decimal logs in production builds (`npm run build`).
# Always on in dev. Or in the browser: localStorage.setItem('flux-swap-dev-logs','1')
# VITE_FLUX_SWAP_DEV_LOGS=true
